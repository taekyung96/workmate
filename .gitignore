# Build
build/
.gradle/
out/
bin/
dist/
node_modules/
*.class

# Vite / Vue
workmate-vue/dist/
# SPA 빌드 산출물이 복사되는 WEB 정적 리소스 (Gradle processResources 가 자동 생성 → 커밋 대상 아님)
workmate-web/src/main/resources/static/
*.local

# IDE
.settings/
.project
.classpath
.factorypath
.idea/
*.iml
.vscode/
# IntelliJ/Antigravity 테스트 실행 시 생성되는 classpath 인자 임시파일
.temp-*
*.temp-*.txt

# Env & secrets
# 비밀값(API 키·DB 비번)은 .env(git 미추적)로만. .env.example → .env 복사 방식
.env
*.local.yml
application-local.yml

# AI 코딩 도구 개인 설정 (프로젝트 규칙 SSOT 는 CLAUDE.md 하나로 유지)
.claude/
.playwright-mcp/

# 개인 작업 노트 — 공개 저장소에 넣지 않는다
.notes/

# 로컬 산출물
docs/**/*.html

# 작업 중 저장한 화면 캡처 (저장소 루트) — 문서용 이미지는 docs/images 에 둔다
/*.png
/*.jpg
/*.jpeg

# OS
Thumbs.db
.DS_Store

# Logs
*.log

# 런타임 업로드 산출물 (영수증 이미지 · 회의 오디오 등)
workmate-was/uploads/
uploads/

# 로컬 테스트용 오디오 (음성 회의록 F8-1 테스트)
*.wav

# 로컬 전용 스크립트 (DB 자격증명 하드코딩 등) — 스크린샷 캡처 스크립트와 그 의존성 정의만 추적
scripts/*
!scripts/capture-all-perfect.js
!scripts/seed-demo-accounts.js
!scripts/bootstrap-demo-data.sh
!scripts/grant-grafana-readonly.sh
!scripts/update-demo-url.sh
!scripts/gen-brand-assets.js
!scripts/package.json
!scripts/package-lock.json
