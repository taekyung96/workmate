# DB 정보
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Gemini (Google AI Studio에서 발급) — 임베딩(RAG)은 항상 이걸 쓴다.
# 채팅 제공자를 Groq 으로 바꿔도 이 키는 계속 필요하다.
GEMINI_API_KEY=

# Groq (console.groq.com 에서 신용카드 없이 발급) — 채팅 전용, 선택 사항.
# Gemini 무료 티어의 분당 한도가 빡빡해 응답이 느릴 때 쓴다(실측: 25~70초 → 7초).
# OpenAI 호환 엔드포인트라 spring-ai 의 openai 스타터를 그대로 쓰고 base-url 만 돌린다.
GROQ_API_KEY=

# 서버가 쓰는 기본 채팅 모델 — modelCode 없이 들어온 요청과 도우미 패널이 이걸 쓴다.
# (화면 드롭다운의 기본 선택값은 여기가 아니라 AI_MODEL 공통코드의 sort_order 첫 번째다.)
# 채팅 제공자는 이 값으로 정해지지 않는다 — 모델마다 어느 제공자인지는
# AI_MODEL 공통코드의 attr1 이 정하고, 요청마다 서버가 고른다(재시작 불필요).
# 허용 목록도 공통코드가 관리한다(관리자 > 공통 코드 화면).
#   Gemini : gemini-flash-latest      (무료 티어 요청 한도 20건 — 자주 429 가 난다)
#   Groq   : qwen/qwen3.8-27b         (권장 — 도구 호출 정상, 한도 넉넉)
#            openai/gpt-oss-120b      (도구 호출이 필요한 질문에서 빈 응답을 돌려준다 — 알려진 문제)
LLM_CHAT_MODEL=qwen/qwen3.8-27b

# 멀티모달(영수증 OCR·음성 전사·회의 요약) 전용 모델. 항상 Gemini 다.
# LLM_CHAT_MODEL 과 반드시 분리돼 있어야 한다 — 예전엔 한 변수로 묶여 있어서
# 채팅 기본 모델을 Groq 으로 바꾸면 Gemini 에 Groq 모델명이 나가 영수증·회의록이 함께 깨졌다.
# 바꿀 일이 없으면 비워 둬도 된다(기본값 gemini-flash-latest).
#LLM_MULTIMODAL_MODEL=gemini-flash-latest

# 개인정보(이메일·전화번호) AES-256 암호화 키
AES_SECRET_KEY=        # openssl rand -base64 32 결과 (이메일·전화번호 AES-256 암호화 키)
AES_SECRET_IV=         # openssl rand -base64 16 결과 (결정적 암호화용 고정 IV)

# 소셜 로그인(F1-1) — 각 제공자 콘솔에서 발급.
# 배포 도메인의 콜백 URL(https://<도메인>/login/oauth2/code/{naver|kakao|google})도 등록해야 한다.
# 안 쓸 거면 아래를 주석 그대로 두면 된다 — compose 가 not-configured 로 채워
# 소셜 버튼만 동작하지 않고 앱은 정상 기동한다.
#NAVER_CLIENT_ID=
#NAVER_CLIENT_SECRET=
#KAKAO_CLIENT_ID=       # 앱 키 중 REST API 키
#KAKAO_CLIENT_SECRET=
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# 배포 전용 (docker-compose.deploy.yml)
# IMAGE_TAG=latest     # 롤백 시 sha-<커밋해시> 로 고정
# TUNNEL_TOKEN=        # Cloudflare Tunnel 토큰 (--profile tunnel 사용 시)

# 관측 스택 (docker compose --profile obs 사용 시에만 필요)
# 둘 다 openssl rand -base64 24 등으로 생성한다
GRAFANA_ADMIN_PASSWORD=      # Grafana 관리자 로그인 비밀번호
GRAFANA_DB_PASSWORD=         # Grafana 가 쓸 읽기 전용 DB 롤(grafana_ro) 비밀번호
